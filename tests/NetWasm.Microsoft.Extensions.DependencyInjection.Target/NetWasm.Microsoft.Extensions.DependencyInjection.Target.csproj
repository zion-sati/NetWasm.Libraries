<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/Generated/*.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/IGeneratedActivator.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/Generated/*.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/ActivatorUtilities.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection.Abstractions/Microsoft/Extensions/DependencyInjection/ObjectFactory.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceProviderOptions.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceProvider.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceCollectionContainerBuilderExtensions.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/DefaultServiceProviderFactory.cs" />
    <Compile Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/ServiceLookup/*.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="GeneratedTestActivationMetadata.cs" />
  </ItemGroup>
</Project>
