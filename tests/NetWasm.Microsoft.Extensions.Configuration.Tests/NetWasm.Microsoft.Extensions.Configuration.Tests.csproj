<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netwasm0.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TUnitSourceGenerationMode>ClosedWorldCatalog</TUnitSourceGenerationMode>
    <NoWarn>$(NoWarn);TUnit0034;TUnit0038</NoWarn>
    <DisableImplicitFrameworkReferences Condition="'$(TargetFramework)' == 'net10.0'">false</DisableImplicitFrameworkReferences>
    <NoStdLib Condition="'$(TargetFramework)' == 'net10.0'">false</NoStdLib>
    <NoStandardLibraries Condition="'$(TargetFramework)' == 'net10.0'">false</NoStandardLibraries>
    <NoCompilerStandardLib Condition="'$(TargetFramework)' == 'net10.0'">false</NoCompilerStandardLib>
    <DisableStandardFrameworkResolution Condition="'$(TargetFramework)' == 'net10.0'">true</DisableStandardFrameworkResolution>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Xunit" />
    <Compile Include="ConfigurationTests.cs" />
    <PackageReference Include="NetWasm.TUnit" Version="[$(NetWasmTUnitPackageVersion)]" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Configuration.Abstractions/NetWasm.Microsoft.Extensions.Configuration.Abstractions.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Configuration/NetWasm.Microsoft.Extensions.Configuration.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Configuration.EnvironmentVariables/NetWasm.Microsoft.Extensions.Configuration.EnvironmentVariables.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Configuration.CommandLine/NetWasm.Microsoft.Extensions.Configuration.CommandLine.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Configuration.Json/NetWasm.Microsoft.Extensions.Configuration.Json.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Configuration.Binder/NetWasm.Microsoft.Extensions.Configuration.Binder.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Options.ConfigurationExtensions/NetWasm.Microsoft.Extensions.Options.ConfigurationExtensions.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.DependencyInjection/NetWasm.Microsoft.Extensions.DependencyInjection.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.Microsoft.Extensions.Options/NetWasm.Microsoft.Extensions.Options.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../tools/NetWasm.Microsoft.Extensions.Configuration.Binder.Generator/NetWasm.Microsoft.Extensions.Configuration.Binder.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="TargetFramework=netstandard2.0;TargetFrameworks=netstandard2.0;DebugType=none;DebugSymbols=false"
                      Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../tools/NetWasm.Microsoft.Extensions.DependencyInjection.Generator/NetWasm.Microsoft.Extensions.DependencyInjection.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="TargetFramework=netstandard2.0;TargetFrameworks=netstandard2.0;DebugType=none;DebugSymbols=false"
                      Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <ProjectReference Include="../../src/NetWasm.System.Text.Json/NetWasm.System.Text.Json.csproj" Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
