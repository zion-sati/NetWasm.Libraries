<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netwasm0.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TUnitSourceGenerationMode>ClosedWorldCatalog</TUnitSourceGenerationMode>
    <NoWarn>$(NoWarn);TUnit0034;TUnit0038</NoWarn>
    <DefineConstants Condition="'$(TargetFramework)' == 'netwasm0.1'">$(DefineConstants);NETWASM</DefineConstants>
    <DisableImplicitFrameworkReferences Condition="'$(TargetFramework)' == 'net10.0'">false</DisableImplicitFrameworkReferences>
    <NoStdLib Condition="'$(TargetFramework)' == 'net10.0'">false</NoStdLib>
    <NoStandardLibraries Condition="'$(TargetFramework)' == 'net10.0'">false</NoStandardLibraries>
    <NoCompilerStandardLib Condition="'$(TargetFramework)' == 'net10.0'">false</NoCompilerStandardLib>
    <DisableStandardFrameworkResolution Condition="'$(TargetFramework)' == 'net10.0'">true</DisableStandardFrameworkResolution>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="Xunit" />
    <Compile Include="LoggingTests.cs" />
    <PackageReference Include="NetWasm.TUnit" Version="[$(NetWasmTUnitPackageVersion)]" />
    <PackageReference Include="NetWasm.Microsoft.Extensions.Logging"
                      Version="[$(NetWasmLoggingPackageVersion)]"
                      Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <PackageReference Include="NetWasm.Microsoft.Extensions.Logging.Abstractions"
                      Version="[$(NetWasmLoggingAbstractionsPackageVersion)]"
                      Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <PackageReference Include="NetWasm.Microsoft.Extensions.DependencyInjection"
                      Version="[$(NetWasmDependencyInjectionPackageVersion)]"
                      Condition="'$(TargetFramework)' == 'netwasm0.1'" />
    <PackageReference Include="Microsoft.Extensions.Logging"
                      Version="10.0.0"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"
                      Version="10.0.0"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                      Version="10.0.0"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
