<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netwasm0.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);NETWASM</DefineConstants>
    <TUnitSourceGenerationMode>ClosedWorldCatalog</TUnitSourceGenerationMode>
    <NoWarn>$(NoWarn);TUnit0034;TUnit0038;CS3021</NoWarn>
    <DisableImplicitFrameworkReferences Condition="'$(TargetFramework)' == 'net10.0'">false</DisableImplicitFrameworkReferences>
    <NoStdLib Condition="'$(TargetFramework)' == 'net10.0'">false</NoStdLib>
    <NoStandardLibraries Condition="'$(TargetFramework)' == 'net10.0'">false</NoStandardLibraries>
    <NoCompilerStandardLib Condition="'$(TargetFramework)' == 'net10.0'">false</NoCompilerStandardLib>
    <DisableStandardFrameworkResolution Condition="'$(TargetFramework)' == 'net10.0'">true</DisableStandardFrameworkResolution>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Xunit" />
    <Compile Include="HashingTests.cs" />
    <Compile Include="HashingAdaptationAssertions.cs" />
    <PackageReference Include="NetWasm.TUnit" Version="[$(NetWasmTUnitPackageVersion)]" />
    <PackageReference Include="NetWasm.System.IO.Hashing"
                      Version="[$(NetWasmSystemIOHashingPackageVersion)]"
                      Condition="'$(TargetFramework)' == 'netwasm0.1'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Adler32.cs" Link="System/IO/Hashing/Adler32.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc32.cs" Link="System/IO/Hashing/Crc32.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc32ParameterSet.cs" Link="System/IO/Hashing/Crc32ParameterSet.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc32ParameterSet.Table.cs" Link="System/IO/Hashing/Crc32ParameterSet.Table.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc32ParameterSet.WellKnown.cs" Link="System/IO/Hashing/Crc32ParameterSet.WellKnown.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc64.cs" Link="System/IO/Hashing/Crc64.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc64ParameterSet.cs" Link="System/IO/Hashing/Crc64ParameterSet.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc64ParameterSet.Table.cs" Link="System/IO/Hashing/Crc64ParameterSet.Table.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/Crc64ParameterSet.WellKnown.cs" Link="System/IO/Hashing/Crc64ParameterSet.WellKnown.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/NonCryptographicHashAlgorithm.cs" Link="System/IO/Hashing/NonCryptographicHashAlgorithm.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHash128.cs" Link="System/IO/Hashing/XxHash128.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHash3.cs" Link="System/IO/Hashing/XxHash3.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHash32.cs" Link="System/IO/Hashing/XxHash32.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHash32.State.cs" Link="System/IO/Hashing/XxHash32.State.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHash64.cs" Link="System/IO/Hashing/XxHash64.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHash64.State.cs" Link="System/IO/Hashing/XxHash64.State.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/XxHashShared.cs" Link="System/IO/Hashing/XxHashShared.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/ThrowHelper.cs" Link="System/ThrowHelper.cs" />
    <Compile Include="../../src/NetWasm.System.IO.Hashing/System/IO/Hashing/SR.cs" Link="System/IO/Hashing/SR.cs" />
  </ItemGroup>
</Project>
