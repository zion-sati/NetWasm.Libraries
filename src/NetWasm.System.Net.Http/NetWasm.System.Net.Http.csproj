<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>System.Net.Http</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <IsPackable>true</IsPackable>
    <DefineConstants>$(DefineConstants);NET;NETWASM;TARGET_WASI</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>NetWasm.System.Net.Http</PackageId>
    <Version>$(NetWasmSystemNetHttpPackageVersion)</Version>
    <PackageVersion>$(NetWasmSystemNetHttpPackageVersion)</PackageVersion>
    <Description>NetWasm netwasm0.1 implementation of System.Net.Http over WASI HTTP.</Description>
    <PackageTags>netwasm;system;net;http;wasi</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>$(NetWasmPortedLibrariesRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(NetWasmPortedLibrariesRepositoryUrl)</RepositoryUrl>
    <PublishRepositoryUrl Condition="'$(NetWasmPortedLibrariesRepositoryUrl)' == ''">false</PublishRepositoryUrl>
    <PublishRepositoryUrl Condition="'$(NetWasmPortedLibrariesRepositoryUrl)' != ''">true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="System/SR.cs" />
    <Compile Include="System/Net/HttpStatusCode.cs" />
    <!-- System.Net.Http at dotnet/runtime 811225a4 (its WASI compile list), copied verbatim and adapted where marked
         "NetWasm:"; members newer than netstandard 2.1 are left out or internal, and WasiHttpHandler sends through
         IHttpTransport, whose default sends through wasi:http 0.3. -->
    <Compile Include="Common/System/**/*.cs" />
    <Compile Include="System/Net/Http/**/*.cs" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="buildTransitive/NetWasm.System.Net.Http.targets;buildTransitive/HttpServiceExports.cs.template"
          Pack="true"
          PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
