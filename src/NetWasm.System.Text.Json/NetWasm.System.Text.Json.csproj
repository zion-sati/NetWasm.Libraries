<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>System.Text.Json</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);NET;NETWASM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>NetWasm.System.Text.Json</PackageId>
    <Version>$(NetWasmSystemTextJsonPackageVersion)</Version>
    <PackageVersion>$(NetWasmSystemTextJsonPackageVersion)</PackageVersion>
    <Description>NetWasm netwasm0.1 implementation of System.Text.Json.</Description>
    <PackageTags>netwasm;system;text;json;serialization</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>$(NetWasmPortedLibrariesRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(NetWasmPortedLibrariesRepositoryUrl)</RepositoryUrl>
    <PublishRepositoryUrl Condition="'$(NetWasmPortedLibrariesRepositoryUrl)' == ''">false</PublishRepositoryUrl>
    <PublishRepositoryUrl Condition="'$(NetWasmPortedLibrariesRepositoryUrl)' != ''">true</PublishRepositoryUrl>
    <NetWasmJsonSourceGenerator>$(NETCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/10.0.10/analyzers/dotnet/cs/System.Text.Json.SourceGeneration.dll</NetWasmJsonSourceGenerator>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <!-- Shared J01A contracts/common helpers. -->
    <Compile Include="Common/System/Text/Json/*.cs" />
    <Compile Include="Common/System/Text/ValueStringBuilder.cs" />
    <Compile Include="Common/System/HexConverter.cs" />
    <Compile Include="Common/System/Marvin.cs" />
    <Compile Include="Common/System/Net/ArrayBuffer.cs" />
    <Compile Include="Common/System/Obsoletions.cs" />
    <Compile Include="System/SR.cs" />

    <!-- Reader and writer lanes own their source; these globs include their files once present. -->
    <Compile Include="System/Text/Json/Reader/**/*.cs" Exclude="System/Text/Json/Reader/JsonReaderHelper.netstandard.cs" />
    <Compile Include="System/Text/Json/Writer/**/*.cs" />
    <Compile Include="System/Text/Json/Serialization/**/*.cs" />

    <Compile Include="System/Text/Json/AppContextSwitchHelper.cs" />
    <Compile Include="System/Text/Json/BitStack.cs" />
    <Compile Include="System/Text/Json/ValueQueue.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.DbRow.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.MetadataDb.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.Parse.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.PropertyNameSet.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.StackRow.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.StackRowStack.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.TryGetProperty.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocument.cs" />
    <Compile Include="System/Text/Json/Document/JsonDocumentOptions.cs" />
    <Compile Include="System/Text/Json/Document/JsonElement.ArrayEnumerator.cs" />
    <Compile Include="System/Text/Json/Document/JsonElement.ObjectEnumerator.cs" />
    <Compile Include="System/Text/Json/Document/JsonElement.Parse.cs" />
    <Compile Include="System/Text/Json/Document/JsonElement.cs" />
    <Compile Include="System/Text/Json/Document/JsonProperty.cs" />
    <Compile Include="System/Text/Json/Document/JsonValueKind.cs" />

    <!-- Mutable JSON DOM (JsonNode/JsonObject/JsonArray/JsonValue). These are
         the pinned upstream Nodes closure and intentionally compile as part of
         the ordinary System.Text.Json assembly. -->
    <Compile Include="System/Text/Json/Nodes/**/*.cs" />

    <Compile Include="System/Text/Json/JsonConstants.cs" />
    <Compile Include="System/Text/Json/JsonEncodedText.cs" />
    <Compile Include="System/Text/Json/JsonException.cs" />
    <Compile Include="System/Text/Json/JsonHelpers.Escaping.cs" />
    <Compile Include="System/Text/Json/JsonHelpers.Date.cs" />
    <Compile Include="System/Text/Json/JsonHelpers.cs" />
    <Compile Include="System/Text/Json/JsonTokenType.cs" />
    <Compile Include="System/Text/Json/ThrowHelper.cs" />
    <Compile Include="System/Text/Json/ThrowHelper.Serialization.cs" />
    <Compile Include="System/Text/Json/ThrowHelper.Node.cs" />
    <PackageReference Include="NetWasm.System.Memory"
                      Version="[$(NetWasmSystemMemoryPackageVersion)]" />
    <PackageReference Include="NetWasm.System.Text.Encodings.Web"
                      Version="[$(NetWasmSystemTextEncodingsWebPackageVersion)]" />
    <PackageReference Include="NetWasm.System.IO.Pipelines"
                      Version="[$(NetWasmSystemIOPipelinesPackageVersion)]" />
    <None Include="$(NetWasmJsonSourceGenerator)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/System.Text.Json.SourceGeneration.dll" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
