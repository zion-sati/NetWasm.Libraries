<Project>
  <!-- Upstream's key for each ported assembly, as dotnet/runtime assigns them: Microsoft.Extensions.* use the
       ASP.NET Core key, System.* the Open key. Sibling libraries that see each other's internals share it. -->
  <PropertyGroup>
    <StrongNameKeyId Condition="'$(StrongNameKeyId)' == '' and $(AssemblyName.StartsWith('Microsoft.Extensions.'))">MicrosoftAspNetCore</StrongNameKeyId>
    <StrongNameKeyId Condition="'$(StrongNameKeyId)' == '' and $(AssemblyName.StartsWith('System.'))">Open</StrongNameKeyId>
    <AssemblyOriginatorKeyFile Condition="'$(StrongNameKeyId)' == 'MicrosoftAspNetCore'">$(MSBuildThisFileDirectory)snk/AspNetCore.snk</AssemblyOriginatorKeyFile>
    <AssemblyOriginatorKeyFile Condition="'$(StrongNameKeyId)' == 'Open'">$(MSBuildThisFileDirectory)snk/Open.snk</AssemblyOriginatorKeyFile>
    <PublicKey Condition="'$(StrongNameKeyId)' == 'MicrosoftAspNetCore'"></PublicKey>
    <PublicKey Condition="'$(StrongNameKeyId)' == 'Open'"></PublicKey>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[-+].*$', ''))</FileVersion>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <InternalsVisibleTo>
      <Key>$(PublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>
  <Target Name="NetWasmLibraryRequireUpstreamKey" BeforeTargets="CoreCompile">
    <Error Condition="'$(AssemblyOriginatorKeyFile)' == '' or !Exists('$(AssemblyOriginatorKeyFile)')"
           Text="Assembly '$(AssemblyName)' has no upstream public key; set StrongNameKeyId to the key upstream signs it with." />
  </Target>
</Project>
