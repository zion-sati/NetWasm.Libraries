<Project>
  <PropertyGroup>
    <!-- Production package graph. These versions are replaced exactly once
         when the immutable release candidate is allocated. -->
    <NetWasmSystemLinqPackageVersion>0.1.0-rc.3</NetWasmSystemLinqPackageVersion>
    <NetWasmSystemLinqAsyncEnumerablePackageVersion>0.1.0-rc.3</NetWasmSystemLinqAsyncEnumerablePackageVersion>
    <NetWasmSystemMemoryPackageVersion>0.1.0-rc.3</NetWasmSystemMemoryPackageVersion>
    <NetWasmSystemIOPipelinesPackageVersion>0.1.0-rc.3</NetWasmSystemIOPipelinesPackageVersion>
    <NetWasmSystemTextEncodingsWebPackageVersion>0.1.0-rc.3</NetWasmSystemTextEncodingsWebPackageVersion>
    <NetWasmSystemTextJsonPackageVersion>0.1.0-rc.3</NetWasmSystemTextJsonPackageVersion>
    <NetWasmSystemXmlPackageVersion>0.1.0-rc.3</NetWasmSystemXmlPackageVersion>
    <NetWasmSystemTextRegularExpressionsPackageVersion>0.1.0-rc.3</NetWasmSystemTextRegularExpressionsPackageVersion>
    <NetWasmSystemIOHashingPackageVersion>0.1.0-rc.3</NetWasmSystemIOHashingPackageVersion>
    <NetWasmSystemNetHttpPackageVersion>0.1.0-rc.3</NetWasmSystemNetHttpPackageVersion>
    <NetWasmDependencyInjectionAbstractionsPackageVersion>0.1.0-rc.3</NetWasmDependencyInjectionAbstractionsPackageVersion>
    <NetWasmDependencyInjectionPackageVersion>0.1.0-rc.3</NetWasmDependencyInjectionPackageVersion>

    <!-- Test-only dependency. TUnit remains outside the production package DAG. -->
    <NetWasmTUnitPackageVersion>0.1.0-rc.3</NetWasmTUnitPackageVersion>
  </PropertyGroup>
</Project>
