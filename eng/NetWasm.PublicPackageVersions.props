<Project>
  <PropertyGroup>
    <!-- Production package graph. These versions are replaced exactly once
         when the immutable release candidate is allocated. -->
    <NetWasmSystemLinqPackageVersion>0.4.0</NetWasmSystemLinqPackageVersion>
    <NetWasmSystemLinqAsyncEnumerablePackageVersion>0.4.0</NetWasmSystemLinqAsyncEnumerablePackageVersion>
    <NetWasmSystemMemoryPackageVersion>0.4.0</NetWasmSystemMemoryPackageVersion>
    <NetWasmSystemIOPipelinesPackageVersion>0.4.0</NetWasmSystemIOPipelinesPackageVersion>
    <NetWasmSystemTextEncodingsWebPackageVersion>0.4.0</NetWasmSystemTextEncodingsWebPackageVersion>
    <NetWasmSystemTextJsonPackageVersion>0.4.0</NetWasmSystemTextJsonPackageVersion>
    <NetWasmSystemXmlPackageVersion>0.4.0</NetWasmSystemXmlPackageVersion>
    <NetWasmSystemTextRegularExpressionsPackageVersion>0.4.0</NetWasmSystemTextRegularExpressionsPackageVersion>
    <NetWasmSystemIOHashingPackageVersion>0.4.0</NetWasmSystemIOHashingPackageVersion>
    <NetWasmSystemNetHttpPackageVersion>0.4.0</NetWasmSystemNetHttpPackageVersion>
    <NetWasmSystemNetHttpJsonPackageVersion>0.4.0</NetWasmSystemNetHttpJsonPackageVersion>
    <NetWasmMicrosoftExtensionsPrimitivesPackageVersion>0.4.0</NetWasmMicrosoftExtensionsPrimitivesPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationAbstractionsPackageVersion>0.4.0</NetWasmMicrosoftExtensionsConfigurationAbstractionsPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationPackageVersion>0.4.0</NetWasmMicrosoftExtensionsConfigurationPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationEnvironmentVariablesPackageVersion>0.4.0</NetWasmMicrosoftExtensionsConfigurationEnvironmentVariablesPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationCommandLinePackageVersion>0.4.0</NetWasmMicrosoftExtensionsConfigurationCommandLinePackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationJsonPackageVersion>0.4.0</NetWasmMicrosoftExtensionsConfigurationJsonPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationBinderPackageVersion>0.4.0</NetWasmMicrosoftExtensionsConfigurationBinderPackageVersion>
    <NetWasmMicrosoftExtensionsOptionsConfigurationExtensionsPackageVersion>0.4.0</NetWasmMicrosoftExtensionsOptionsConfigurationExtensionsPackageVersion>
    <NetWasmMicrosoftExtensionsCachingAbstractionsPackageVersion>0.4.0</NetWasmMicrosoftExtensionsCachingAbstractionsPackageVersion>
    <NetWasmMicrosoftExtensionsCachingMemoryPackageVersion>0.4.0</NetWasmMicrosoftExtensionsCachingMemoryPackageVersion>
    <NetWasmMicrosoftExtensionsHttpPackageVersion>0.4.0</NetWasmMicrosoftExtensionsHttpPackageVersion>
    <NetWasmDependencyInjectionAbstractionsPackageVersion>0.4.0</NetWasmDependencyInjectionAbstractionsPackageVersion>
    <NetWasmDependencyInjectionPackageVersion>0.4.0</NetWasmDependencyInjectionPackageVersion>
    <NetWasmOptionsPackageVersion>0.4.0</NetWasmOptionsPackageVersion>
    <NetWasmLoggingAbstractionsPackageVersion>0.4.0</NetWasmLoggingAbstractionsPackageVersion>
    <NetWasmLoggingPackageVersion>0.4.0</NetWasmLoggingPackageVersion>

    <!-- Test-only dependency. TUnit remains outside the production package DAG. -->
    <NetWasmTUnitPackageVersion>0.4.1</NetWasmTUnitPackageVersion>
  </PropertyGroup>
</Project>
