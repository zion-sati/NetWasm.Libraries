<Project>
  <PropertyGroup>
    <!-- Production package graph. These versions are replaced exactly once
         when the immutable release candidate is allocated. -->
    <NetWasmSystemLinqPackageVersion>0.4.2</NetWasmSystemLinqPackageVersion>
    <NetWasmSystemLinqAsyncEnumerablePackageVersion>0.4.2</NetWasmSystemLinqAsyncEnumerablePackageVersion>
    <NetWasmSystemMemoryPackageVersion>0.4.2</NetWasmSystemMemoryPackageVersion>
    <NetWasmSystemIOPipelinesPackageVersion>0.4.2</NetWasmSystemIOPipelinesPackageVersion>
    <NetWasmSystemTextEncodingsWebPackageVersion>0.4.2</NetWasmSystemTextEncodingsWebPackageVersion>
    <NetWasmSystemTextJsonPackageVersion>0.4.2</NetWasmSystemTextJsonPackageVersion>
    <NetWasmSystemXmlPackageVersion>0.4.2</NetWasmSystemXmlPackageVersion>
    <NetWasmSystemTextRegularExpressionsPackageVersion>0.4.2</NetWasmSystemTextRegularExpressionsPackageVersion>
    <NetWasmSystemIOHashingPackageVersion>0.4.2</NetWasmSystemIOHashingPackageVersion>
    <NetWasmSystemNetHttpPackageVersion>0.4.2</NetWasmSystemNetHttpPackageVersion>
    <NetWasmSystemNetHttpJsonPackageVersion>0.4.2</NetWasmSystemNetHttpJsonPackageVersion>
    <NetWasmMicrosoftExtensionsPrimitivesPackageVersion>0.4.2</NetWasmMicrosoftExtensionsPrimitivesPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationAbstractionsPackageVersion>0.4.2</NetWasmMicrosoftExtensionsConfigurationAbstractionsPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationPackageVersion>0.4.2</NetWasmMicrosoftExtensionsConfigurationPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationEnvironmentVariablesPackageVersion>0.4.2</NetWasmMicrosoftExtensionsConfigurationEnvironmentVariablesPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationCommandLinePackageVersion>0.4.2</NetWasmMicrosoftExtensionsConfigurationCommandLinePackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationJsonPackageVersion>0.4.2</NetWasmMicrosoftExtensionsConfigurationJsonPackageVersion>
    <NetWasmMicrosoftExtensionsConfigurationBinderPackageVersion>0.4.2</NetWasmMicrosoftExtensionsConfigurationBinderPackageVersion>
    <NetWasmMicrosoftExtensionsOptionsConfigurationExtensionsPackageVersion>0.4.2</NetWasmMicrosoftExtensionsOptionsConfigurationExtensionsPackageVersion>
    <NetWasmMicrosoftExtensionsCachingAbstractionsPackageVersion>0.4.2</NetWasmMicrosoftExtensionsCachingAbstractionsPackageVersion>
    <NetWasmMicrosoftExtensionsCachingMemoryPackageVersion>0.4.2</NetWasmMicrosoftExtensionsCachingMemoryPackageVersion>
    <NetWasmMicrosoftExtensionsHttpPackageVersion>0.4.2</NetWasmMicrosoftExtensionsHttpPackageVersion>
    <NetWasmDependencyInjectionAbstractionsPackageVersion>0.4.2</NetWasmDependencyInjectionAbstractionsPackageVersion>
    <NetWasmDependencyInjectionPackageVersion>0.4.2</NetWasmDependencyInjectionPackageVersion>
    <NetWasmOptionsPackageVersion>0.4.2</NetWasmOptionsPackageVersion>
    <NetWasmLoggingAbstractionsPackageVersion>0.4.2</NetWasmLoggingAbstractionsPackageVersion>
    <NetWasmLoggingPackageVersion>0.4.2</NetWasmLoggingPackageVersion>

    <!-- Test-only dependency. TUnit remains outside the production package DAG. -->
    <NetWasmTUnitPackageVersion>0.4.2</NetWasmTUnitPackageVersion>
  </PropertyGroup>
</Project>
