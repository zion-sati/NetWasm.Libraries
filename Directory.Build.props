<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <RepositorySourceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</RepositorySourceRoot>
    <PathMap Condition="'$(PathMap)' == ''">$(RepositorySourceRoot)=/_/</PathMap>
    <NetWasmPackageCacheRoot Condition="'$(NUGET_PACKAGES)' != ''">$([System.IO.Path]::GetFullPath('$(NUGET_PACKAGES)'))</NetWasmPackageCacheRoot>
    <NetWasmArtifactsRoot Condition="'$(ArtifactsPath)' != ''">$([System.IO.Path]::GetFullPath('$(ArtifactsPath)'))</NetWasmArtifactsRoot>
    <PathMap Condition="'$(NetWasmPackageCacheRoot)' != ''">$(PathMap),$(NetWasmPackageCacheRoot)=/_/nuget</PathMap>
    <PathMap Condition="'$(NetWasmArtifactsRoot)' != ''">$(PathMap),$(NetWasmArtifactsRoot)=/_/artifacts</PathMap>
    <Authors>Zion Sati</Authors>
    <PackageOwners>Zion Sati</PackageOwners>
    <Copyright>Copyright © 2026 Zion Sati</Copyright>
    <NetWasmPortedLibrariesRepositoryUrl>https://github.com/zion-sati/NetWasm.Libraries</NetWasmPortedLibrariesRepositoryUrl>
    <PackageProjectUrl>$(NetWasmPortedLibrariesRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(NetWasmPortedLibrariesRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)eng/NetWasm.PublicPackageVersions.props" />
</Project>
